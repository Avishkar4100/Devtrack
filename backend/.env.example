PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/devtrack
MONGO_URI_DIRECT=mongodb://<user>:<password>@cluster0-shard-00-00.xxxxx.mongodb.net:27017,cluster0-shard-00-01.xxxxx.mongodb.net:27017,cluster0-shard-00-02.xxxxx.mongodb.net:27017/devtrack?ssl=true&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
ADMIN_EMAIL=admin@devtrack.local
ADMIN_PASSWORD=change_me_admin_password
AI_SERVICE_URL=http://localhost:8000
GITHUB_TOKEN=your_github_token_here
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_token_here
